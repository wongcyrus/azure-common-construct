{
  "name": "azure-common-construct",
  "author": "Cyrus Wong",
  "version": "0.1.0",
  "description": "Reusable Azure infrastructure patterns for CDK Terrain",
  "repository": {
    "url": "https://github.com/wongcyrus/azure-common-construct",
    "type": "git"
  },
  "main": "patterns/index.js",
  "types": "patterns/index.d.ts",
  "files": [
    "patterns/**/*.js",
    "patterns/**/*.d.ts",
    "patterns/*.ps1",
    "patterns/*.sh",
    "README.md"
  ],
  "license": "MPL-2.0",
  "keywords": [
    "cdktn",
    "cdk-terrain",
    "opentofu",
    "terraform",
    "azure"
  ],
  "scripts": {
    "build": "tsc",
    "compile": "tsc --pretty",
    "watch": "tsc -w",
    "test": "npm run build",
    "upgrade": "npm install cdktn@latest"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "cdktn": "^0.24.0",
    "constructs": ">=10.6.0 <10.8.0",
    "cdktf-azure-providers": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/prettier": "3.0.0",
    "@types/sha256-file": "^1.0.3",
    "cdktn": "^0.24.0",
    "constructs": "^10.6.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "fast-sha256": "^1.3.0",
    "get-all-files": "^5.0.0",
    "sha256-file": "^1.0.0"
  }
}
